# BANCO DE DADOS MySQL (Hostinger)
# Crie o banco em hPanel -> Bancos de Dados -> MySQL e copie os dados abaixo.
# Na Hostinger o app conecta pelo 127.0.0.1 (mesmo servidor). As tabelas são criadas sozinhas.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="u000000000_missaoosi"
DB_USER="u000000000_missaoosi"
DB_PASSWORD="sua-senha-do-banco"

# Chave de acesso ao Painel do Professor (/professor/login)
TEACHER_ACCESS_KEY="troque-esta-chave"
